              "pm.test(\"Metadata dan isActive terganti\", function () { pm.expect(responseBody.capacity).to.eql(12); pm.expect(responseBody.name).to.eql(\"Ruang Postman Revisi\"); pm.expect(responseBody.isActive).to.eql(false); });"
            ]
          }
        }
      ]
