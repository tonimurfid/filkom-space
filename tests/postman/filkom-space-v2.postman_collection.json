{
  "info": {
    "name": "FILKOM Space API v2 PUT PATCH DELETE",
    "description": "Pengujian mutasi v2. Isi roomBase, reservationBase, adminPassword, studentPassword sebelum menjalankan. POST hanya membuat fixture simulasi. Jalankan seluruh koleksi berurutan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "roomBase",
      "value": "http://localhost:8081"
    },
    {
      "key": "reservationBase",
      "value": "http://localhost:8082"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "studentPassword",
      "value": ""
    },
    {
      "key": "studentId",
      "value": "235150200111001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"roomCode\")) pm.collectionVariables.set(\"roomCode\", \"PMV2-\" + Date.now());",
          "if (!pm.collectionVariables.get(\"date\")) pm.collectionVariables.set(\"date\", new Date(Date.now()+7*86400000).toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Persiapan POST ruangan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{roomBase}}/api/v2/rooms",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{roomCode}}\",\n  \"name\": \"Ruang Postman V2\",\n  \"building\": \"Gedung Simulasi\",\n  \"floor\": 2,\n  \"capacity\": 10,\n  \"facilities\": [\n    \"WIFI\",\n    \"PROYEKTOR\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "var responseBody = pm.response.json();",
              "pm.test(\"Location v2\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v2/rooms/\"+responseBody.id); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"roomId\", responseBody.id);"
            ]
          }
        }
      ]
    },
