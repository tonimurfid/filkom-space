            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "var responseBody = pm.response.json();",
              "pm.test(\"Jadwal v2\", function () { pm.expect(responseBody.schedule.startTime).to.eql(\"13:00\"); pm.expect(responseBody).not.to.have.property(\"startTime\"); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"reservationId\", responseBody.id);"
            ]
          }
        }
